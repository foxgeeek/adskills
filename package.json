{
  "name": "adskills",
  "version": "0.1.0",
  "description": "Claude Code Skills framework for multi-platform ad ops (Meta, Google, LinkedIn)",
  "type": "module",
  "bin": {
    "adskills": "./dist/commands/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n site,cli,test -c \"cyan,green,magenta\" --kill-others-on-fail \"pnpm dev:site\" \"pnpm dev:cli\" \"pnpm dev:test\"",
    "dev:site": "pnpm --dir site dev",
    "dev:cli": "tsc --noEmit --watch --preserveWatchOutput",
    "dev:test": "vitest",
    "cli": "tsx src/commands/cli.ts",
    "build": "pnpm build:cli && pnpm build:site",
    "build:cli": "tsc",
    "build:site": "pnpm --dir site build",
    "start": "pnpm --dir site start",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' '*.md'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "ads",
    "meta-ads",
    "google-ads",
    "linkedin-ads",
    "skills"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "facebook-nodejs-business-sdk": "^21.0.0",
    "google-ads-api": "^23.0.0",
    "kleur": "^4.1.5",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
